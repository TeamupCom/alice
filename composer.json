{
    "name": "nelmio/alice",
    "description": "Expressive fixtures generator",
    "keywords": ["fixture", "data", "test", "orm"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jordi Boggiano",
            "email": "j.boggiano@seld.be"
        },
        {
            "name": "Tim Shelburne",
            "email": "shelburt02@gmail.com"
        },
        {
            "name": "Théo FIDRY",
            "email": "theo.fidry@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "psr/log": "^1 || ^2 || ^3",
        "fakerphp/faker": "^1.24",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/common": "^2.3",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.3",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": { "Nelmio\\Alice\\": "src/Nelmio/Alice" }
    },
    "autoload-dev": {
        "psr-4": { "Nelmio\\Alice\\": "tests/Nelmio/Alice" }
    },
    "scripts": {
        "phpunit": "vendor/bin/phpunit",
        "phpstan:check": "vendor/bin/phpstan analyse",
        "rector:check": "vendor/bin/rector --dry-run",
        "rector:fix": "vendor/bin/rector"
    }
}
